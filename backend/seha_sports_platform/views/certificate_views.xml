<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_seha_certificate_list" model="ir.ui.view">
        <field name="name">seha.medical.certificate.list</field>
        <field name="model">seha.medical.certificate</field>
        <field name="arch" type="xml">
            <list string="Unified Medical Certificates" decoration-success="state == 'valid'" decoration-danger="state == 'expired'" decoration-warning="state == 'suspended'" decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="player_id"/>
                <field name="athlete_national_id"/>
                <field name="sport_id"/>
                <field name="level"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="issuing_hospital"/>
                <field name="state" widget="badge"/>
                <field name="is_valid" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_seha_certificate_form" model="ir.ui.view">
        <field name="name">seha.medical.certificate.form</field>
        <field name="model">seha.medical.certificate</field>
        <field name="arch" type="xml">
            <form string="Unified Sports Medical Certificate">
                <header>
                    <button name="action_validate" type="object" string="Validate &amp; Certify / اعتماد الشهادة" class="oe_highlight" invisible="state == 'valid'" groups="seha_sports_platform.group_seha_medical,seha_sports_platform.group_seha_admin"/>
                    <button name="action_suspend" type="object" string="Suspend / تعليق" invisible="state in ['suspended', 'revoked']" groups="seha_sports_platform.group_seha_medical,seha_sports_platform.group_seha_admin"/>
                    <button name="action_revoke" type="object" string="Revoke / إلغاء" invisible="state == 'revoked'" groups="seha_sports_platform.group_seha_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,valid,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Active Clearance" bg_color="bg-success" invisible="not is_valid"/>
                    <widget name="web_ribbon" title="Expired" bg_color="bg-danger" invisible="state != 'expired' and is_valid"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Certificate Number"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="decree_reference" readonly="1" class="text-muted"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Athlete &amp; Sports Clearance">
                            <field name="player_id"/>
                            <field name="athlete_national_id"/>
                            <field name="sport_id"/>
                            <field name="certificate_type"/>
                            <field name="level"/>
                        </group>
                        <group string="Issuance &amp; Validity">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="is_valid"/>
                            <field name="issuing_hospital"/>
                            <field name="physician_name"/>
                            <field name="physician_license"/>
                            <field name="qr_code_hash" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Clinical Findings &amp; Observations" name="findings">
                            <field name="notes" placeholder="ECG normal, blood pressure within normal limits, cardiac murmur absent, cleared for competitive sports..."/>
                        </page>
                        <page string="Legal Standing &amp; Compliance" name="legal">
                            <group>
                                <field name="decree_reference" readonly="1"/>
                                <field name="law_compliance" readonly="1"/>
                                <field name="issued_by_user_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_seha_certificate_search" model="ir.ui.view">
        <field name="name">seha.medical.certificate.search</field>
        <field name="model">seha.medical.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Medical Certificates">
                <field name="name"/>
                <field name="player_id"/>
                <field name="athlete_national_id"/>
                <field name="issuing_hospital"/>
                <field name="physician_name"/>
                <field name="qr_code_hash"/>
                
                <separator/>
                <filter string="Valid / سارية" name="filter_valid" domain="[('state', '=', 'valid'), ('is_valid', '=', True)]"/>
                <filter string="Expired / منتهية" name="filter_expired" domain="['|', ('state', '=', 'expired'), ('is_valid', '=', False)]"/>
                <filter string="Suspended / معلقة" name="filter_suspended" domain="[('state', '=', 'suspended')]"/>
                
                <separator/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Level" name="group_level" context="{'group_by': 'level'}"/>
                    <filter string="Certificate Type" name="group_type" context="{'group_by': 'certificate_type'}"/>
                    <filter string="Hospital" name="group_hospital" context="{'group_by': 'issuing_hospital'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_seha_certificate" model="ir.actions.act_window">
        <field name="name">Medical Certificates / الشهادات الطبية</field>
        <field name="res_model">seha.medical.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_seha_certificate_search"/>
        <field name="context">{'search_default_filter_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Issue a new verified sports medical clearance certificate!
            </p>
            <p>
                All certificates follow Decree 1642 / 2024 and Law 151 / 2020 standards with QR verification.
            </p>
        </field>
    </record>
</odoo>
