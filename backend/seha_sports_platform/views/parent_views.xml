<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_seha_parent_list" model="ir.ui.view">
        <field name="name">seha.parent.list</field>
        <field name="model">seha.parent</field>
        <field name="arch" type="xml">
            <list string="Parents &amp; Guardians / أولياء الأمور" decoration-success="verification_status == 'verified'" decoration-warning="verification_status == 'pending'">
                <field name="code"/>
                <field name="name"/>
                <field name="national_id"/>
                <field name="relationship_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="children_count" string="Connected Children"/>
                <field name="verification_status" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_seha_parent_form" model="ir.ui.view">
        <field name="name">seha.parent.form</field>
        <field name="model">seha.parent</field>
        <field name="arch" type="xml">
            <form string="Parent / Guardian Profile (ملف ولي الأمر)">
                <header>
                    <field name="verification_status" widget="statusbar" statusbar_visible="pending,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_seha_player)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users"
                                context="{'search_default_parent_ids': id}">
                            <field name="children_count" widget="statinfo" string="Children"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Guardian Full Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. يوسف عبدالله السيد"/>
                        </h1>
                        <h3>
                            <field name="code" readonly="1" class="text-muted"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Identity &amp; Legal Relationship">
                            <field name="national_id" placeholder="14-digit Egyptian National ID"/>
                            <field name="relationship_type"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Account Linkage">
                            <field name="partner_id" readonly="1" groups="base.group_no_one"/>
                            <field name="user_id" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Connected Athlete Children" name="children">
                            <field name="player_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="age"/>
                                    <field name="sport_id"/>
                                    <field name="club_name"/>
                                    <field name="fitness_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Relationship Audit &amp; Approvals" name="relations">
                            <field name="player_relation_ids">
                                <list editable="bottom">
                                    <field name="player_id"/>
                                    <field name="relationship"/>
                                    <field name="verification_status" widget="badge"/>
                                    <field name="verification_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Civil registry verification notes, power of attorney, custody documents..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_seha_parent_search" model="ir.ui.view">
        <field name="name">seha.parent.search</field>
        <field name="model">seha.parent</field>
        <field name="arch" type="xml">
            <search string="Search Parents &amp; Guardians">
                <field name="name"/>
                <field name="code"/>
                <field name="national_id"/>
                <field name="phone"/>
                
                <separator/>
                <filter string="Verified / موثق" name="filter_verified" domain="[('verification_status', '=', 'verified')]"/>
                <filter string="Pending / قيد الفحص" name="filter_pending" domain="[('verification_status', '=', 'pending')]"/>
                
                <separator/>
                <group name="group_by">
                    <filter string="Relationship" name="group_relationship" context="{'group_by': 'relationship_type'}"/>
                    <filter string="Verification Status" name="group_status" context="{'group_by': 'verification_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_seha_parent" model="ir.actions.act_window">
        <field name="name">Parents &amp; Guardians / أولياء الأمور</field>
        <field name="res_model">seha.parent</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_seha_parent_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new parent or legal guardian!
            </p>
            <p>
                Manage family accounts, connected athlete children, and guardian authorization.
            </p>
        </field>
    </record>
</odoo>
