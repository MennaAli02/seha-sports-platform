# =============================================================================
# SEHA SPORTSMED PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Usernames and passwords are intentionally left empty for security.
# Fill them manually before running the project locally or on servers.
# =============================================================================

# --- Database (PostgreSQL) ---
DB_HOST=seha-db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
ODOO_DB_NAME=sports_platform

# --- Odoo 19 Backend ---
ODOO_PORT=8022
ODOO_ADMIN_PASSWORD=
ODOO_ADDONS_PATH=/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Frontend (Vite / React) ---
VITE_PORT=3001
VITE_BACKEND_PROXY_TARGET=http://localhost:8022
VITE_API_BASE_URL=
